# ============================================
# Production Environment Variables
# ============================================
# Copy file ini ke .env di VPS:
#   /home/apps/builds/<group>/<project>/.env
# Lalu isi semua value, dan jalankan: chmod 600 .env
# ============================================

# ---------- Image & Container ----------
IMAGE_REGISTRY=gitlab.vascomm.co.id:4567/<group>/<project>
IMAGE_NAME=lms-ai
IMAGE_TAG=latest

CONTAINER_NAME=lms-ai
APP_PORT=3000

# ---------- Caddy Domain ----------
CADDY_DOMAIN=academy.sitamoto.ai

# ---------- Node ----------
NODE_ENV=production

# ---------- Database (PostgreSQL, external di network "database") ----------
DATABASE_URL=postgresql://<user>:<password>@<postgres_container>:5432/<db_name>?schema=public

# ---------- NextJS / Auth ----------
NEXTAUTH_URL=https://academy.sitamoto.ai
# generate: openssl rand -hex 32
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true

# ---------- Encryption (untuk decrypt API key AI provider di DB) ----------
# generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ---------- Object Storage (RustFS, S3-compatible) ----------
# Public domain RustFS via Caddy (DNS harus resolve ke VPS)
RUSTFS_DOMAIN=rustfs.sitamoto.ai
# Credentials (ganti dengan key yang kuat!)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=ChangeMe123!
# Bucket untuk media publik (akan dibuat otomatis oleh rustfs-init)
RUSTFS_BUCKET=lms-media

# ---------- Redis (queue/cache) ----------
# Default mengarah ke container redis di compose. Jika redis eksternal, isi penuh.
REDIS_URL=redis://redis:6379

# ---------- Email (SMTP) ----------
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ---------- Payment (Xendit) ----------
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# ---------- AI ----------
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- Business Info ----------
BUSINESS_NAME=Sitamoto Academy
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_WHATSAPP=
