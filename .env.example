# ============================================
# Development Environment Variables
# ============================================
# Copy file ini ke .env untuk development lokal:
#   cp .env.example .env
#
# Prasyarat: jalankan service lokal dengan:
#   docker compose up -d   (postgres, redis, minio)
#
# Lalu jalankan dev server:
#   pnpm dev   (port 4000)
# ============================================

# ---------- Node ----------
NODE_ENV=development

# ---------- Database (PostgreSQL lokal, docker-compose.yml) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/lms_db?schema=public

# ---------- NextJS / Auth ----------
NEXTAUTH_URL=http://localhost:4000
# dev only — generate: openssl rand -hex 32
NEXTAUTH_SECRET=dev-secret-change-me
AUTH_TRUST_HOST=true

# ---------- Encryption (untuk decrypt API key AI provider di DB) ----------
# dev only — generate: openssl rand -hex 32
ENCRYPTION_KEY=dev-encryption-key-change-me-32hex

# ---------- Object Storage (MinIO lokal, docker-compose.yml) ----------
MINIO_ENDPOINT=localhost
MINIO_PORT=9004
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lms-media

# ---------- Redis (lokal, docker-compose.yml) ----------
REDIS_URL=redis://localhost:6381

# ---------- Email (SMTP) ----------
# Opsional di dev. Jika kosong, email tidak dikirim (kecuali di production).
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ---------- Payment (Xendit) ----------
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# ---------- AI ----------
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- Business Info ----------
BUSINESS_NAME=Sitamoto Academy
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_WHATSAPP=
